{
  // Cloud or local development environment for the CDM collateral prototype.
  // GitHub Codespaces: docs/setup-codespaces.md. Starts the four-node Besu network on every start.
  "name": "cdm-collateral",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "postStartCommand": "bash besu/start-network.sh",
  "forwardPorts": [8545, 8546, 8547, 8548, 8549, 8550, 8551, 8552],
  "portsAttributes": {
    "8545": { "label": "Besu mkt RPC" },
    "8547": { "label": "Besu bank-a RPC" },
    "8549": { "label": "Besu bank-b RPC" },
    "8551": { "label": "Besu bank-c RPC" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "dbaeumer.vscode-eslint", "NomicFoundation.hardhat-solidity"] }
  }
}
