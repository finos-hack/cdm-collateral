{
  // Cloud or local development environment for the CDM collateral prototype.
  // GitHub Codespaces: docs/setup-codespaces.md. On creation: the one-time build (scripts/live-e2e.sh build). On every
  // start: the full live stack (scripts/live-e2e.sh up) — Besu, contracts if not deployed, store, gateways, services
  // and the console dev server on 5173 (task-devcontainer-stack-startup).
  "name": "cdm-collateral",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/java:1": { "version": "21" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "postCreateCommand": "bash scripts/live-e2e.sh build",
  "postStartCommand": "bash scripts/live-e2e.sh up",
  // 8001/8002: the console calls the collateral services directly from the browser (console/src/domain/liveApi.ts),
  // so they must be forwarded for the live flow to work (task-devcontainer-live-stack).
  // appPort: Docker publishes these on the host's loopback when the container is created, so a host browser reaches
  // the console and both services without an IDE doing the forwarding (forwardPorts is applied only by a client such
  // as VS Code or Codespaces). Bound to 127.0.0.1 because the services have no authentication. The console dev server
  // must listen on 0.0.0.0 for a published port to reach it (CONSOLE_HOST, orchestrate.mjs); the Javalin services
  // already listen on all interfaces.
  "appPort": ["127.0.0.1:5173:5173", "127.0.0.1:8001:8001", "127.0.0.1:8002:8002"],
  "containerEnv": { "CONSOLE_HOST": "0.0.0.0" },
  "forwardPorts": [5173, 8001, 8002, 8545, 8546, 8547, 8548, 8549, 8550, 8551, 8552],
  "portsAttributes": {
    "5173": { "label": "Collateral Console" },
    "8001": { "label": "Collateral service A (pledgor)" },
    "8002": { "label": "Collateral service B (secured party)" },
    "8545": { "label": "Besu mkt RPC" },
    "8547": { "label": "Besu bank-a RPC" },
    "8549": { "label": "Besu bank-b RPC" },
    "8551": { "label": "Besu bank-c RPC" }
  },
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack", "ms-python.python", "dbaeumer.vscode-eslint", "NomicFoundation.hardhat-solidity"] }
  }
}
