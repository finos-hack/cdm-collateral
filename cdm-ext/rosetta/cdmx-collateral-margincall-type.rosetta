namespace cdmx.collateral.margincall : <"Local CDM extension: margin call lifecycle as a sequence of steps over a state record, following the pattern of CDM 7.7.0's instruction composition (gaps G1, G3, G4, G6 in docs/cdm-development/gap-register.md). CDM's own CompositionState is a closed choice, so the pattern is mirrored here rather than extended. Not part of FINOS CDM.">
version "${project.version}"

import cdm.base.staticdata.party.*
import cdm.event.common.*
import cdm.observable.asset.*
import cdmx.collateral.proposal.*

enum MarginCallStatusEnum: <"State of a margin call.">
    Issued <"Issued by the calling party; waiting for the called party's response.">
    Agreed <"The called party agreed the full amount.">
    PartiallyAgreed <"The called party agreed part of the amount; the rest is disputed.">
    Disputed <"The called party disputed the whole amount; nothing is due until the dispute is resolved.">
    Settled <"The agreed amount has been delivered or released; any disputed amount stays recorded on the call.">
    Cancelled <"Withdrawn by the calling party before a response, or cancelled by both parties after one; nothing is due under the call and any proposal not delivered is void.">

enum CancellationStatusEnum: <"State of a request to cancel an answered margin call (ISO 20022 colr.005 and colr.006).">
    Requested <"Requested by one party; waiting for the other party's decision.">
    Accepted <"Accepted by the other party; the call is cancelled.">
    Refused <"Refused by the other party; the call continues where it was.">

enum MarginCallStepEnum: <"The steps of the margin call lifecycle (ISO 20022 colr.003, colr.004, colr.007, colr.008).">
    IssueCall <"The calling party issues the call (MarginCallIssuance).">
    RespondToCall <"The called party agrees, partially agrees or disputes (MarginCallResponse).">
    ProposeCollateral <"The delivering party proposes collateral (CollateralProposal); delivery calls only.">
    DecideProposal <"The receiving party accepts or rejects the proposal.">
    SettleCall <"The agreed amount is delivered against an accepted proposal, or released for a return call.">
    WithdrawCall <"The calling party withdraws the call before the called party has answered it.">
    RequestCancellation <"Either party asks to cancel an answered call that is not settled (colr.005).">
    DecideCancellation <"The other party accepts or refuses the cancellation request (colr.006).">

type IssueCallInstruction: <"Step IssueCall.">
    issuance MarginCallIssuance (1..1) <"The call as CDM represents it.">
    direction MarginCallActionEnum (1..1) <"Delivery: the called party delivers collateral. Return: the called party releases collateral it holds.">

    condition CallIdentified: <"The call carries an identifier so later steps can refer to it.">
        issuance -> callIdentifier exists

    condition PledgorAndSecuredParty: <"The call names one pledgor and one secured party (MarginCallBase -> partyRole), who pay and receive the collateral transfers on settlement.">
        (issuance -> partyRole filter role = PartyRoleEnum -> Pledgor then count) = 1
            and (issuance -> partyRole filter role = PartyRoleEnum -> SecuredParty then count) = 1

type DecideProposalInstruction: <"Step DecideProposal.">
    proposalId string (1..1) <"The proposal decided (its assigned identifier).">
    accept boolean (1..1)
    reason string (0..1) <"Why a proposal was rejected.">

type SettleCallInstruction: <"Step SettleCall.">
    proposalId string (0..1) <"Delivery call: the accepted proposal delivered.">
    releasedCollateral CollateralPosition (0..*) <"Return call: the collateral released.">
    releasedValue Money (0..1) <"Return call: value after haircuts of the collateral released.">

    condition DeliveryOrReturn: <"A settlement names either the proposal delivered or the value released.">
        required choice proposalId, releasedValue

// Cancellation rules (task-csa-call-cancellation, the project owner's choice of 2026-11-06, to be confirmed by a
// business SME in task-sme-call-cancellation-rules): the calling party withdraws an unanswered call alone; an answered
// call that is not settled, wholly disputed ones included, is cancelled only on one party's request and the other's
// acceptance; a proposal not yet delivered is then void.

type WithdrawCallInstruction: <"Step WithdrawCall: by the calling party.">
    reason string (1..1) <"Why the call is withdrawn, for example an amount booked in error.">

type RequestCancellationInstruction: <"Step RequestCancellation (ISO 20022 colr.005).">
    requestedBy PartyRoleEnum (1..1) <"Pledgor or SecuredParty.">
    reason string (0..1)

    condition PledgorOrSecuredParty:
        requestedBy = PartyRoleEnum -> Pledgor or requestedBy = PartyRoleEnum -> SecuredParty

type DecideCancellationInstruction: <"Step DecideCancellation (ISO 20022 colr.006).">
    decidedBy PartyRoleEnum (1..1) <"The party that did not request the cancellation.">
    accept boolean (1..1)
    reason string (0..1) <"Why a cancellation was refused.">

type CancellationRequest: <"A request to cancel the call and its outcome.">
    requestedBy PartyRoleEnum (1..1)
    reason string (0..1)
    status CancellationStatusEnum (1..1)
    decisionReason string (0..1)

type MarginCallInstruction: <"Exactly one step to apply to a margin call.">
    issue IssueCallInstruction (0..1)
    respond MarginCallResponse (0..1)
    propose CollateralProposal (0..1)
    decide DecideProposalInstruction (0..1)
    settle SettleCallInstruction (0..1)
    withdraw WithdrawCallInstruction (0..1)
    requestCancellation RequestCancellationInstruction (0..1)
    decideCancellation DecideCancellationInstruction (0..1)

    condition OneStep:
        one-of

type MarginCallStepRecord: <"One applied step, for the audit trail.">
    identifier string (1..1)
    timestamp zonedDateTime (1..1) <"When the step took effect, for example the ledger block time.">
    step MarginCallStepEnum (1..1)

type MarginCallState: <"Cumulative record of one margin call: the call, the response, proposals and settlement, with the steps applied so far.">
    [rootType]
    issuance MarginCallIssuance (1..1)
    direction MarginCallActionEnum (1..1)
    status MarginCallStatusEnum (1..1)
    response MarginCallResponse (0..1)
    agreedAmount Money (0..1)
    disputedAmount Money (0..1)
    proposal CollateralProposal (0..*)
    settlement SettleCallInstruction (0..1)
    withdrawal WithdrawCallInstruction (0..1) <"Set when the calling party withdrew the call.">
    cancellation CancellationRequest (0..*) <"Cancellation requests in order; at most the last is still Requested.">
    stepRecord MarginCallStepRecord (1..*)

    condition AmountsAfterResponse: <"Agreed and disputed amounts are known once the call has been answered; a call withdrawn before a response has none.">
        if status <> MarginCallStatusEnum -> Issued and withdrawal is absent
        then agreedAmount exists and disputedAmount exists

    condition OnePendingCancellation:
        (cancellation filter status = CancellationStatusEnum -> Requested then count) <= 1

    condition CancelledHasReason: <"A cancelled call was withdrawn or has an accepted cancellation request.">
        if status = MarginCallStatusEnum -> Cancelled
        then withdrawal exists or (cancellation filter status = CancellationStatusEnum -> Accepted then exists)

    condition ReturnsNeedNoProposal: <"A return releases collateral already held; it is not proposed.">
        if direction = MarginCallActionEnum -> Return
        then proposal is absent
