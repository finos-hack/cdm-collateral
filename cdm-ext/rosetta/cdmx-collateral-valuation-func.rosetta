namespace cdmx.collateral.valuation : <"Local CDM extension: IM valuation of posted credit support with the additional haircut applied (gap G7, defect D1).">
version "${project.version}"

import cdm.base.*
import cdm.base.math.*
import cdm.observable.asset.*
import cdm.legaldocumentation.csa.*

// CDM 7.7.0 PostedCreditSupportItemAmount reads fxHaircutPercentage for the additional haircut (defect D1), so the FX
// haircut is subtracted twice and additionalHaircutPercentage never. Rune calls functions by name, so the corrected
// function is used only by callers that name it: UndisputedAdjustedPostedCreditSupportAmount, DeliveryAmount and
// ReturnAmount are restated below on top of it. CreditSupportAmount does not use the item value and is CDM's own.
// The haircut formula is otherwise CDM's: value x (1 - (haircut + FX haircut + additional haircut)).

func CorrectedPostedCreditSupportItemAmount: <"The Value of one Posted Credit Support item after its haircut, FX haircut and additional haircut, less its disputed value (CDM PostedCreditSupportItemAmount with D1 corrected). An absent FX or additional haircut counts as zero.">
    [docReference ISDA CSA_IM_NewYork_2018 paragraph "13"]
    [calculation]
    inputs:
        postedItem PostedCreditSupportItem (1..1) <"Posted Credit Support Item.">
        baseCurrency string (1..1) <"Base Currency means the currency specified as such in Paragraph 13.">
    output:
        result Money (1..1)

    alias fxHaircutPercentage:
        if postedItem -> fxHaircutPercentage exists then postedItem -> fxHaircutPercentage else 0.0

    alias additionalHaircutPercentage:
        if postedItem -> additionalHaircutPercentage exists then postedItem -> additionalHaircutPercentage else 0.0

    alias postedCreditSupportAmount:
        postedItem -> cashOrSecurityValue -> value
            * (1.0 - (postedItem -> haircutPercentage + fxHaircutPercentage + additionalHaircutPercentage))

    condition CurrencyMatches: <"The item's value and disputed value are in the base currency.">
        baseCurrency = postedItem -> cashOrSecurityValue -> unit -> currency
            and baseCurrency = postedItem -> disputedCashOrSecurityValue -> unit -> currency

    set result -> value:
        postedCreditSupportAmount - postedItem -> disputedCashOrSecurityValue -> value

    set result -> unit -> currency: baseCurrency

func CorrectedUndisputedAdjustedPostedCreditSupportAmount: <"Undisputed Adjusted Posted Credit Support Amount (IM) from the corrected item values (CDM UndisputedAdjustedPostedCreditSupportAmount on CorrectedPostedCreditSupportItemAmount).">
    [calculation]
    inputs:
        postedCreditSupportItems PostedCreditSupportItem (0..*) <"Posted Credit Support Items.">
        priorDeliveryAmountAdjustment Money (1..1) <"The adjustment value to include any prior Delivery Amount (IM).">
        priorReturnAmountAdjustment Money (1..1) <"The adjustment value to exclude any prior Return Amount (IM).">
        disputedTransferredPostedCreditSupportAmount Money (1..1) <"The disputed value of any Transfer of Eligible Credit Support.">
        baseCurrency string (1..1) <"Base Currency means the currency specified as such in Paragraph 13.">
    output:
        result Money (1..1)

    alias totalPostedCreditSupportAmount:
        postedCreditSupportItems
            extract CorrectedPostedCreditSupportItemAmount(item, baseCurrency) -> value
            then sum

    condition CurrencyMatches: <"The adjustments and the disputed transfer are in the base currency.">
        (baseCurrency = priorDeliveryAmountAdjustment -> unit -> currency)
            and (baseCurrency = priorReturnAmountAdjustment -> unit -> currency)
            and (baseCurrency = disputedTransferredPostedCreditSupportAmount -> unit -> currency)

    set result -> value:
        totalPostedCreditSupportAmount + priorDeliveryAmountAdjustment -> value - priorReturnAmountAdjustment -> value
            - disputedTransferredPostedCreditSupportAmount -> value

    set result -> unit -> currency: baseCurrency

func CorrectedDeliveryAmount: <"Delivery Amount (IM) from the corrected posted credit support value (CDM DeliveryAmount on CorrectedUndisputedAdjustedPostedCreditSupportAmount): rounded up, zero below the minimum transfer amount.">
    [docReference ISDA CSA_IM_2018 paragraph "3" clause "a" name "Delivery Amount"]
    [calculation]
    inputs:
        postedCreditSupportItems PostedCreditSupportItem (0..*)
        priorDeliveryAmountAdjustment Money (1..1)
        priorReturnAmountAdjustment Money (1..1)
        disputedTransferredPostedCreditSupportAmount Money (1..1)
        marginAmount Money (1..1) <"The Base Currency Equivalent of the sum of the initial margin amounts.">
        threshold Money (1..1)
        marginApproach MarginApproachEnum (1..1)
        marginAmountIA Money (0..1)
        minimumTransferAmount Money (1..1)
        rounding CollateralRounding (1..1)
        disputedDeliveryAmount Money (1..1)
        baseCurrency string (1..1)
    output:
        result Money (1..1)

    alias posted:
        CorrectedUndisputedAdjustedPostedCreditSupportAmount(
                postedCreditSupportItems,
                priorDeliveryAmountAdjustment,
                priorReturnAmountAdjustment,
                disputedTransferredPostedCreditSupportAmount,
                baseCurrency
            )

    alias creditSupportAmount: CreditSupportAmount(marginAmount, threshold, marginApproach, marginAmountIA, baseCurrency)

    alias undisputedDeliveryAmount:
        Max(Max(creditSupportAmount -> value - posted -> value, 0.0) - disputedDeliveryAmount -> value, 0.0)

    condition CurrencyMatches: <"The minimum transfer amount and the disputed delivery amount are in the base currency.">
        baseCurrency = minimumTransferAmount -> unit -> currency
            and baseCurrency = disputedDeliveryAmount -> unit -> currency

    set result -> value:
        if undisputedDeliveryAmount >= minimumTransferAmount -> value
        then RoundToNearest(undisputedDeliveryAmount, rounding -> deliveryAmount, RoundingModeEnum -> Up)
        else 0.0

    set result -> unit -> currency: baseCurrency

func CorrectedReturnAmount: <"Return Amount (IM) from the corrected posted credit support value (CDM ReturnAmount on CorrectedUndisputedAdjustedPostedCreditSupportAmount): rounded down, zero below the minimum transfer amount.">
    [docReference ISDA CSA_IM_2018 paragraph "3" clause "(b)"]
    [calculation]
    inputs:
        postedCreditSupportItems PostedCreditSupportItem (0..*)
        priorDeliveryAmountAdjustment Money (1..1)
        priorReturnAmountAdjustment Money (1..1)
        disputedTransferredPostedCreditSupportAmount Money (1..1)
        marginAmount Money (1..1) <"The Base Currency Equivalent of the sum of the initial margin amounts.">
        threshold Money (1..1)
        marginApproach MarginApproachEnum (1..1)
        marginAmountIA Money (0..1)
        minimumTransferAmount Money (1..1)
        rounding CollateralRounding (1..1)
        disputedReturnAmount Money (1..1)
        baseCurrency string (1..1)
    output:
        result Money (1..1)

    alias posted:
        CorrectedUndisputedAdjustedPostedCreditSupportAmount(
                postedCreditSupportItems,
                priorDeliveryAmountAdjustment,
                priorReturnAmountAdjustment,
                disputedTransferredPostedCreditSupportAmount,
                baseCurrency
            )

    alias creditSupportAmount: CreditSupportAmount(marginAmount, threshold, marginApproach, marginAmountIA, baseCurrency)

    alias undisputedReturnAmount:
        Max(Max(posted -> value - creditSupportAmount -> value, 0.0) - disputedReturnAmount -> value, 0.0)

    condition CurrencyMatches: <"The minimum transfer amount and the disputed return amount are in the base currency.">
        baseCurrency = minimumTransferAmount -> unit -> currency
            and baseCurrency = disputedReturnAmount -> unit -> currency

    set result -> value:
        if undisputedReturnAmount >= minimumTransferAmount -> value
        then RoundToNearest(undisputedReturnAmount, rounding -> returnAmount, RoundingModeEnum -> Down)
        else 0.0

    set result -> unit -> currency: baseCurrency
