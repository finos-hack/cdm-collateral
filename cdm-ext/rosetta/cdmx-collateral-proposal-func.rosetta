namespace cdmx.collateral.proposal : <"Local CDM extension: functions for collateral proposals (gap G2).">
version "${project.version}"

import cdm.observable.asset.*

func ProposalCoversAgreedAmount: <"True if the proposal's value after haircuts covers the agreed amount of the call, in the same currency.">
    inputs:
        proposal CollateralProposal (1..1)
        agreedAmount Money (1..1)
    output:
        covers boolean (1..1)

    condition SameCurrency: <"The proposal is valued in the currency of the agreed amount.">
        proposal -> valueAfterHaircuts -> unit -> currency = agreedAmount -> unit -> currency

    set covers:
        proposal -> valueAfterHaircuts -> value >= agreedAmount -> value

func DecideCollateralProposal: <"Records the receiving party's decision on a proposal that is still Proposed.">
    inputs:
        proposal CollateralProposal (1..1)
        accept boolean (1..1)
        reason string (0..1)
    output:
        decided CollateralProposal (1..1)

    condition StillProposed: <"Only a proposal waiting for a decision can be decided.">
        proposal -> status = CollateralProposalStatusEnum -> Proposed

    // Generated Python: `set decided: proposal` followed by `set decided -> attribute` writes through to the
    // caller's proposal (D15), so a new proposal is built with a constructor.
    set decided:
        CollateralProposal {
            proposalIdentifier: proposal -> proposalIdentifier,
            callIdentifier: proposal -> callIdentifier,
            proposedCollateral: proposal -> proposedCollateral,
            valueAfterHaircuts: proposal -> valueAfterHaircuts,
            status: if accept = True then CollateralProposalStatusEnum -> Accepted else CollateralProposalStatusEnum -> Rejected,
            decision: CollateralProposalDecision { accepted: accept, reason: reason }
        }
