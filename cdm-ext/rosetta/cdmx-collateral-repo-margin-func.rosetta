namespace cdmx.collateral.repo : <"Local CDM extension: margin maintenance on repos under a GMRA (gap G12, defect D2, wp-adr-repo-margin-maintenance).">
version "${project.version}"

import cdm.event.common.*
import cdm.base.math.*
import cdm.observable.asset.*
import cdm.base.datetime.*
import cdm.product.common.settlement.*
import cdmx.collateral.gmra.*

func RepoMarginRatio: <"The Margin Ratio a Transaction's Transaction Exposure uses: by the marginRatioBasis election, the Transaction's own marginPercentage or the agreement's default Margin Ratio; the default also applies to a Transaction that states none.">
    inputs:
        tradeState TradeState (1..1)
        elections GmraElections (1..1)
    output:
        marginRatio number (1..1)

    alias stated:
        tradeState -> trade -> product -> economicTerms -> collateral -> collateralProvisions -> eligibleCollateral -> treatment -> valuationTreatment -> marginPercentage only-element

    set marginRatio:
        if elections -> marginRatioBasis = MarginRatioBasisEnum -> PerTransaction and stated exists
        then stated
        else elections -> defaultMarginRatio

func RepoPurchasePriceForMarketValue: <"Defect D2: the Purchase Price that a market value of securities supports at a Margin Ratio, market value / Margin Ratio. CDM's SecurityFinanceCashSettlementAmount multiplies by the ratio, which gives cash above the market value, although CDM defines marginPercentage as market value over Purchase Price.">
    inputs:
        marketValue number (1..1)
        marginRatio number (1..1) <"Market value over Purchase Price.">
    output:
        purchasePrice number (1..1)

    condition NotNegativeMarketValue:
        marketValue >= 0
    condition PositiveMarginRatio:
        marginRatio > 0

    set purchasePrice: marketValue / marginRatio

func RepoTransactionExposure: <"A Transaction's Transaction Exposure on a date: the Repurchase Price accrued to the date times the Margin Ratio, less the market value of the securities at the price. Positive when the Buyer is exposed to the Seller.">
    inputs:
        tradeState TradeState (1..1)
        date date (1..1) <"The day the Price Differential is accrued to.">
        quantity number (1..1) <"The number of securities purchased.">
        price number (1..1) <"The price of one unit of the security on the date.">
        marginRatio number (1..1)
    output:
        exposure number (1..1)

    condition NotNegativeQuantity:
        quantity >= 0
    condition NotNegativePrice:
        price >= 0
    condition PositiveMarginRatio:
        marginRatio > 0

    set exposure:
        (RepoPurchasePrice(tradeState) -> value + RepoPriceDifferential(tradeState, date)) * marginRatio - quantity * price

func RepoRepricedPurchasePrice: <"The new Purchase Price of a repriced Transaction (GMRA paragraph 4(i)(i), wp-adr-repo-reprice): the market value of its securities at the price divided by the Margin Ratio, so its Transaction Exposure is eliminated; rounded to the nearest at the given number of decimals.">
    inputs:
        quantity number (1..1) <"The number of securities purchased.">
        price number (1..1) <"The price of one unit of the security on the reprice date.">
        marginRatio number (1..1)
        precision int (1..1) <"The decimals of the cash amount.">
    output:
        purchasePrice number (1..1)

    set purchasePrice:
        RoundToPrecision(
                RepoPurchasePriceForMarketValue(quantity * price, marginRatio),
                precision,
                RoundingDirectionEnum -> Nearest,
                True
            )

func RepoRepriceCashDifference: <"The cash that settles a reprice (wp-adr-repo-reprice): the old Purchase Price plus the Price Differential accrued to the reprice date, less the new Purchase Price, rounded to the nearest at the given number of decimals. Positive when the Seller pays the Buyer, negative when the Buyer pays the Seller.">
    inputs:
        tradeState TradeState (1..1) <"The Transaction before the reprice.">
        date date (1..1) <"The reprice date.">
        newPurchasePrice number (1..1)
        precision int (1..1) <"The decimals of the cash amount.">
    output:
        cashDifference number (1..1)

    condition PositiveNewPurchasePrice:
        newPurchasePrice > 0

    set cashDifference:
        RoundToPrecision(
                RepoPurchasePrice(tradeState) -> value + RepoPriceDifferential(tradeState, date) - newPurchasePrice,
                precision,
                RoundingDirectionEnum -> Nearest,
                True
            )

func RepoIsReprice: <"Whether a BusinessEvent reprices a repo (wp-adr-repo-reprice, defect D20): one open and one closed trade state after it, a changed cash quantity, an unchanged security quantity and an unchanged Repurchase Date. CDM's Qualify_Reprice cannot be true for a repo whose lot holds both the cash and the security, because ExtractTradePurchasePrice and ExtractTradeCollateralQuantity read the same list of all quantities and it requires that list both to differ and to match.">
    inputs:
        businessEvent BusinessEvent (1..1)
    output:
        is_event boolean (1..1)

    alias priorLot: ExtractBeforeTrade(businessEvent) -> tradeLot only-element -> priceQuantity
    alias newLot: ExtractAfterTrade(businessEvent) -> tradeLot only-element -> priceQuantity
    alias priorCash: priorLot filter item -> price -> priceType any = PriceTypeEnum -> InterestRate then extract item -> quantity then extract item -> value
    alias newCash: newLot filter item -> price -> priceType any = PriceTypeEnum -> InterestRate then extract item -> quantity then extract item -> value
    alias priorSecurity: priorLot filter item -> price -> priceType any = PriceTypeEnum -> AssetPrice then extract item -> quantity then extract item -> value
    alias newSecurity: newLot filter item -> price -> priceType any = PriceTypeEnum -> AssetPrice then extract item -> quantity then extract item -> value

    set is_event:
        FilterOpenTradeStates(businessEvent -> after) count = 1
            and FilterClosedTradeStates(businessEvent -> after) count = 1
            and priorCash exists
            and newCash exists
            and priorCash <> newCash
            and priorSecurity exists
            and priorSecurity = newSecurity
            and ExtractOpenEconomicTerms(businessEvent) -> terminationDate = ExtractBeforeEconomicTerms(businessEvent) -> terminationDate

func RepoIsAdjustment: <"Whether a BusinessEvent adjusts a repo (wp-adr-repo-adjustment, defect D20): one open and one closed trade state after it, an unchanged cash quantity, a changed security quantity and an unchanged Repurchase Date. CDM's Qualify_Adjustment cannot be true for a repo whose lot holds both the cash and the security, for the same reason as Qualify_Reprice.">
    inputs:
        businessEvent BusinessEvent (1..1)
    output:
        is_event boolean (1..1)

    alias priorLot: ExtractBeforeTrade(businessEvent) -> tradeLot only-element -> priceQuantity
    alias newLot: ExtractAfterTrade(businessEvent) -> tradeLot only-element -> priceQuantity
    alias priorCash: priorLot filter item -> price -> priceType any = PriceTypeEnum -> InterestRate then extract item -> quantity then extract item -> value
    alias newCash: newLot filter item -> price -> priceType any = PriceTypeEnum -> InterestRate then extract item -> quantity then extract item -> value
    alias priorSecurity: priorLot filter item -> price -> priceType any = PriceTypeEnum -> AssetPrice then extract item -> quantity then extract item -> value
    alias newSecurity: newLot filter item -> price -> priceType any = PriceTypeEnum -> AssetPrice then extract item -> quantity then extract item -> value

    set is_event:
        FilterOpenTradeStates(businessEvent -> after) count = 1
            and FilterClosedTradeStates(businessEvent -> after) count = 1
            and priorCash exists
            and priorCash = newCash
            and priorSecurity exists
            and newSecurity exists
            and priorSecurity <> newSecurity
            and ExtractOpenEconomicTerms(businessEvent) -> terminationDate = ExtractBeforeEconomicTerms(businessEvent) -> terminationDate

func RepoAccruedPriceDifferential: <"The Price Differential accrued to a date, rounded to the nearest at the given number of decimals: the cash the Seller pays the Buyer at an adjustment (wp-adr-repo-adjustment).">
    inputs:
        tradeState TradeState (1..1) <"The Transaction before the adjustment.">
        date date (1..1) <"The adjustment date.">
        precision int (1..1) <"The decimals of the cash amount.">
    output:
        accrued number (1..1)

    set accrued:
        RoundToPrecision(
                RoundToPrecision(RepoPriceDifferential(tradeState, date), 10, RoundingDirectionEnum -> Nearest, True),
                precision,
                RoundingDirectionEnum -> Nearest,
                True
            )

func RepoAdjustmentInstruction: <"Defect D21: the primitive instruction of a repo adjustment (wp-adr-repo-adjustment). CDM's Create_AdjustmentPrimitiveInstruction writes the new quantity into every quantity of the lot, so it also sets the cash quantity to the number of securities. This has the same shape, with the change limited to the securities' price quantity, as CDM's Create_RepricePrimitiveInstruction limits its change to the cash.">
    inputs:
        tradeState TradeState (1..1)
        newAllinPrice number (1..1) <"The new price of one unit of the security.">
        newAssetQuantity number (1..1) <"The new number of securities.">
        effectiveDate AdjustableOrRelativeDate (1..1) <"The adjustment date.">
    output:
        instruction PrimitiveInstruction (1..1)

    alias lot: tradeState -> trade -> tradeLot only-element -> priceQuantity

    alias currentAssetPrice:
        lot
            extract price
            then flatten
            then filter priceType = PriceTypeEnum -> AssetPrice
            then only-element

    alias newPrice:
        Price {
            value: newAllinPrice,
            unit: currentAssetPrice -> unit,
            perUnitOf: currentAssetPrice -> perUnitOf,
            priceType: currentAssetPrice -> priceType,
            priceSubType: currentAssetPrice -> priceSubType,
            priceExpression: currentAssetPrice -> priceExpression,
            composite: currentAssetPrice -> composite,
            arithmeticOperator: currentAssetPrice -> arithmeticOperator,
            premiumType: currentAssetPrice -> premiumType,
            datedValue: empty,
            ...
        }

    alias changeSecurityQuantity:
        lot
            filter price -> priceType any = PriceTypeEnum -> AssetPrice
            then extract
                NonNegativeQuantitySchedule {
                    value: newAssetQuantity,
                    unit: quantity -> unit,
                    ...
                }
            then distinct

    alias newPriceQuantity:
        changeSecurityQuantity
            extract
                PriceQuantity {
                    price: [newPrice],
                    quantity: item,
                    ...
                }

    set instruction -> split -> breakdown:
        [Create_TerminationInstruction(tradeState, effectiveDate)]

    add instruction -> split -> breakdown:
        [
            PrimitiveInstruction {
                quantityChange:
                    QuantityChangeInstruction {
                        change: [newPriceQuantity],
                        direction: QuantityChangeDirectionEnum -> Replace,
                        lotIdentifier: empty
                    },
                termsChange: Create_EffectiveOrTerminationDateTermChangeInstruction(
                            tradeState -> trade -> product,
                            effectiveDate,
                            empty
                        ),
                ...
            }
        ]

func RepoNetExposure: <"A party's Net Exposure to the other: the sum of the Transaction Exposures across the pair's repos, each stated from this party's side (positive when this party is exposed), less the net margin this party holds. Positive when this party may call margin.">
    inputs:
        exposures number (0..*) <"The Transaction Exposures, from this party's side, in both directions.">
        netMarginHeld number (1..1) <"The margin value this party holds net; negative when it has transferred margin net.">
    output:
        netExposure number (1..1)

    set netExposure: (exposures sum) - netMarginHeld

func RepoMarginCallAmount: <"The amount a party may call: its Net Exposure when that exceeds its minimum transfer amount, otherwise zero.">
    inputs:
        netExposure number (1..1)
        minimumTransferAmount number (1..1)
    output:
        amount number (1..1)

    condition NotNegativeMinimum:
        minimumTransferAmount >= 0

    set amount:
        if netExposure > minimumTransferAmount then netExposure else 0.0

func RepoNetMarginInterest: <"Interest on Cash Margin for a period (GMRA paragraph 4(f)): balance x (the observed overnight rate + the election's spread) x days / 360, rounded to the nearest at the given number of decimals. One rate for the whole period, entered by hand in the prototype.">
    inputs:
        balance number (1..1) <"The Cash Margin held throughout the period.">
        observedRate number (1..1) <"As a decimal (4.5% is 0.045).">
        days int (1..1)
        netMarginInterest NetMarginInterest (1..1)
        precision int (1..1)
    output:
        interest number (1..1)

    condition NotNegativeBalance:
        balance >= 0
    condition NotNegativeDays:
        days >= 0

    set interest:
        RoundToPrecision(
                balance * (observedRate + netMarginInterest -> spread) * days / 360,
                precision,
                RoundingDirectionEnum -> Nearest,
                True
            )
